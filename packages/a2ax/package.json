{
  "name": "@simple-harmonic/a2ax",
  "version": "0.1.0",
  "description": "A2A-Extended: agent-to-agent communication protocol with broadcast, groups, and task management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./transport/memory": {
      "types": "./dist/transport/memory.d.ts",
      "import": "./dist/transport/memory.js"
    },
    "./adapters/json-file": {
      "types": "./dist/adapters/json-file.d.ts",
      "import": "./dist/adapters/json-file.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "a2a",
    "agent",
    "protocol",
    "multi-agent",
    "communication"
  ],
  "author": "Simple Harmonic",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
