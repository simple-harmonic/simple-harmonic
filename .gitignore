# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# app config (may contain API keys)
simple-harmonic.config.json
.simple-harmonic/secrets.json
# JSON file store (runtime team/agent/message state; a2ax tokens are secrets)
# Match the root store and any nested copy (e.g. a test run from packages/backend).
**/.simple-harmonic/data/
# isolated CODEX_HOME for app-server agents (holds a copy of codex OAuth tokens)
.simple-harmonic/codex-home/
.apollo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# local agent-loop state + dev scratch
.claude/ralph-loop.local.md
/test.mts
/test.py
