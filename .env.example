# ---------------------------------------------------------------------------
# Simple Harmonic environment. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Neon Postgres — MUST use pooler.neon.tech (not direct)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/simple_harmonic?sslmode=require

# Anthropic API — $50/day cap recommended. Primary LLM provider.
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API — optional fallback when ANTHROPIC_API_KEY is unset.
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=o4-mini

# ---------------------------------------------------------------------------
# Operator gate + cost controls
# ---------------------------------------------------------------------------

# Single shared operator secret. Gates mutating + settings API routes and pages
# via middleware. REQUIRED in production (the app fails closed without it); in
# local dev an unset value leaves the app open. Also accepted as a Bearer token
# for scripted access.
# OPERATOR_PASSWORD=change-me-to-a-long-random-string

# Cron secret for /api/tick (the tick runs every team's agents). Vercel platform
# cron is accepted via the x-vercel-cron header; the dev loop and manual
# triggers send this as a Bearer token. REQUIRED in production; unset is allowed
# in local dev.
# CRON_SECRET=another-long-random-string

# Hard daily LLM spend ceiling in US cents (default 5000 = $50/day). The tick
# skips once the day's recorded spend reaches this.
# SH_DAILY_SPEND_CAP_CENTS=5000

# ---------------------------------------------------------------------------
# v0.1 agent tools (T1/T2/T3). See packages/backend/src/server/tools/.
# ---------------------------------------------------------------------------

# Master kill switch for DESTRUCTIVE tools (write_file, run_command, mutating
# github_api). Default OFF. Read-only tools (read_file, http_fetch GET) always
# work. Only set this on a checkout you intend agents to modify.
# SH_ENABLE_TOOLS=1

# Jail root for filesystem + shell tools. Defaults to the process cwd.
# Point this at the repo you want agents to work in (dogfooding).
# SH_TOOLS_CWD=/absolute/path/to/checkout

# Per-agent wall-clock budget per tick, in ms (default 120000). A hung LLM call
# or tool can't exceed this; the agent is errored and rescheduled.
# SH_AGENT_TIMEOUT_MS=120000

# GitHub token for the github_api tool. Required for mutating (non-GET) calls.
# Manage via Apollo (or your secret manager) in shared environments. (D18)
# GITHUB_TOKEN=ghp_xxx
